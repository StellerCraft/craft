# Stellar Configuration (INJECTED by CRAFT)
NEXT_PUBLIC_STELLAR_NETWORK={{STELLAR_NETWORK}}
NEXT_PUBLIC_HORIZON_URL={{HORIZON_URL}}
NEXT_PUBLIC_NETWORK_PASSPHRASE={{NETWORK_PASSPHRASE}}

# Branding (INJECTED by CRAFT)
NEXT_PUBLIC_APP_NAME={{APP_NAME}}
NEXT_PUBLIC_PRIMARY_COLOR={{PRIMARY_COLOR}}
NEXT_PUBLIC_SECONDARY_COLOR={{SECONDARY_COLOR}}

# Compliance (OPTIONAL — read by @craft/stellar asset-compliance.ts)
# Server-side only: do NOT prefix with NEXT_PUBLIC_.
#
# COMPLIANCE_BLOCKLIST_JSON — issuer blocklist as a single-line serialised
# JSON array of { "issuer": "<G... account ID>", "reason": "<text>" } objects.
# Issuers are matched case-insensitively. Assets from a listed issuer are
# flagged with COMPLIANCE_ISSUER_BLOCKED=true and COMPLIANCE_KYC_REQUIRED=true
# (flags are warnings only and never block deployment).
#
# WARNING: the value must be valid JSON. A malformed value is logged as
# "[asset-compliance] Failed to parse COMPLIANCE_BLOCKLIST_JSON" and falls back
# to an EMPTY blocklist, which disables issuer compliance checks (see #1113).
# Leave unset (or set to []) to run without a blocklist.
#
# Example:
# COMPLIANCE_BLOCKLIST_JSON=[{"issuer":"GABC...XYZ","reason":"Sanctioned issuer"}]
COMPLIANCE_BLOCKLIST_JSON=[]

# COMPLIANCE_JURISDICTION_JSON — per-jurisdiction asset restrictions as a
# serialised JSON array of { "jurisdiction": "<ISO 3166-1 alpha-2>",
# "blockedAssets": ["<ASSET_CODE>", ...] } objects. Same malformed-value
# fallback behaviour as COMPLIANCE_BLOCKLIST_JSON.
#
# Example:
# COMPLIANCE_JURISDICTION_JSON=[{"jurisdiction":"US","blockedAssets":["TOKEN"]}]
COMPLIANCE_JURISDICTION_JSON=[]
